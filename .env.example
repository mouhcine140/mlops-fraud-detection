# Copy this file to .env and adjust as needed.
# When unset, the app falls back to a local SQLite file so the whole
# pipeline can run without any external service (see src/common/config.py).

# Full pipeline via docker-compose:
# DATABASE_URL=postgresql+psycopg2://fraud_user:fraud_pass@localhost:5432/fraud_db

# Local demo (no docker required):
DATABASE_URL=sqlite:///data/processed/fraud.db

MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=fraud-detection

MODEL_DIR=models
API_HOST=0.0.0.0
API_PORT=8000
